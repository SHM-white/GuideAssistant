<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GuideAssistant.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GuideAssistant.ViewModels"
    Title="设置">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView x:Name="SettingsNav" PaneDisplayMode="LeftCompact"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    OpenPaneLength="180"
                    CompactPaneLength="48"
                    SelectionChanged="SettingsNav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Icon="Keyboard" Content="快捷键" Tag="hotkeys" />
            <NavigationViewItem Icon="AllApps" Content="游戏管理" Tag="games" />
            <NavigationViewItem Icon="View"     Content="显示"   Tag="display" />
            <NavigationViewItem Icon="Help"     Content="关于"   Tag="about" />
        </NavigationView.MenuItems>

        <NavigationView.Content>
            <Grid>
                <ScrollViewer x:Name="HotkeysPage" Visibility="Visible">
                    <StackPanel Spacing="8" Padding="24,16">
                        <TextBlock Text="自定义快捷键" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="点击快捷键绑定 Ctrl/Alt/Shift/Win 组合键；同一组合键可对应多个操作，Esc 取消。" FontSize="12" Opacity="0.6" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                            <ComboBox x:Name="HotkeyScopeSelector" Header="编辑方案" MinWidth="220"
                                      DisplayMemberPath="Name" SelectionChanged="HotkeyScope_SelectionChanged" />
                            <Button x:Name="ResetGameHotkeysButton" Content="恢复继承全局"
                                    VerticalAlignment="Bottom" Click="ResetGameHotkeys_Click" />
                        </StackPanel>
                        <TextBlock x:Name="HotkeyScopeHint" FontSize="12" Opacity="0.7"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ListView x:Name="HotkeyList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:HotkeyRow">
                                    <Grid Padding="4,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="14" VerticalAlignment="Center" />
                                        <HyperlinkButton Grid.Column="1"
                                                 Content="{x:Bind CurrentBinding, Mode=OneWay}"
                                                 FontSize="13" MinWidth="80"
                                                 HorizontalAlignment="Right"
                                                 Click="HotkeyRebind_Click" />
                                        <Button Grid.Column="2" FontSize="12"
                                                Width="28" Height="28" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                Opacity="0.4"
                                                Click="HotkeyClear_Click"
                                                ToolTipService.ToolTip="清除快捷键绑定" >
                                            <SymbolIcon Symbol="Refresh" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <ContentControl x:Name="GamesPage" Visibility="Collapsed" />

                <ScrollViewer x:Name="DisplayPage" Visibility="Collapsed">
                    <StackPanel Spacing="16" Padding="24,16">
                        <TextBlock Text="显示设置" FontSize="18" FontWeight="SemiBold" />
                        <CheckBox x:Name="SubtitleToggle" Content="启用字幕覆盖窗口" />
                        <CheckBox x:Name="MinimapToggle" Content="启用小地图覆盖窗口" />
                        <CheckBox x:Name="MinimapFilterToggle" Content="小地图文字过滤（仅当出现地图关键词时显示方向）" />
                        <TextBlock Text="透明度" FontSize="14" Margin="0,8,0,0" />
                        <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1.0"
                        StepFrequency="0.05" Width="200" HorizontalAlignment="Left" />
                        <TextBlock x:Name="OpacityLabel" FontSize="12" Opacity="0.6" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AboutPage" Visibility="Collapsed">
                    <StackPanel Spacing="8" Padding="24,16">
                        <TextBlock Text="关于" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="GuideAssistant" FontSize="16" />
                        <TextBlock Text="游戏视频攻略辅助工具" FontSize="13" Opacity="0.7" />
                        <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.5" Margin="0,8,0,0" />
                        <TextBlock Text="基于 WinUI 3 + WebView2 构建" FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Key capture dialog -->
                <ContentDialog x:Name="KeyCaptureDialog"
                       x:FieldModifier="private"
                       CloseButtonText="取消"
                       Style="{StaticResource DefaultContentDialogStyle}">
                    <StackPanel x:Name="KeyCaptureContent" Spacing="8" HorizontalAlignment="Center" Padding="0,8"
                        IsTabStop="True" KeyDown="OnKeyCaptureKeyDown" KeyUp="OnKeyCaptureKeyUp">
                        <TextBlock Text="按住修饰键，再按目标键…" FontSize="14" TextAlignment="Center" />
                        <TextBlock Text="按 Esc 或点击取消放弃修改" FontSize="12" TextAlignment="Center" Opacity="0.5" />
                    </StackPanel>
                </ContentDialog>
            </Grid>
        </NavigationView.Content>
    </NavigationView>
</Window>
